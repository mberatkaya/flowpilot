# Reference only: supply these settings in the hosting environment/secret store.
# ASP.NET Core does not automatically load this file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080
AllowedHosts=REPLACE_WITH_PUBLIC_HOST

# Replace through the hosting secret store; never commit a real value.
# Use the provider's trusted CA configuration for VerifyFull if required.
ConnectionStrings__Default="Host=REPLACE_WITH_DB_HOST;Port=5432;Database=REPLACE_WITH_DB_NAME;Username=REPLACE_WITH_DB_USER;Password=REPLACE_WITH_SECRET;SSL Mode=VerifyFull"

# Hosting must expose HTTPS and forward / and /api to the same application.
# The Kestrel HTTP port is internal; do not expose it directly to the Internet.
# Do not enable broad forwarded-header trust or AllowAnyOrigin.
# Migration is a separate release step; the application does not migrate on startup.
