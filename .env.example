# Docker Compose reads .env; ASP.NET Core does not automatically load this file.
# Set ConnectionStrings:Default with environment variables or .NET User Secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Local PostgreSQL only. Replace the placeholder in your ignored .env file.
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=REPLACE_LOCALLY
POSTGRES_PORT=5433

# Docker Compose serves both the React frontend and API on this host port.
APP_PORT=5080
# Compose uses postgres:5432 internally, independently of the local connection below.

# Reference value only: use the same locally chosen password as above.
ConnectionStrings__Default="Host=localhost;Port=5433;Database=flowpilot;Username=flowpilot;Password=REPLACE_LOCALLY"

# Production reference only: supply values through your hosting environment/secret store.
# Do not use the local connection string or launchSettings.json in production.
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://0.0.0.0:8080
# AllowedHosts=flowpilot.example.com
# ConnectionStrings__Default=<production connection string from a secret store>
# Terminate HTTPS at the chosen hosting layer; configure hosting before live delivery.
