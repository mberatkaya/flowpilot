# Public browser configuration only. Never place secrets in VITE_* variables.
# API root, including /api. /api uses the same origin in development and production.
# For a separate origin, use https://api.example.com/api and configure trusted CORS there.
VITE_API_BASE_URL=/api

# Development proxy target only; never embedded in the browser build.
API_PROXY_TARGET=http://localhost:5080
